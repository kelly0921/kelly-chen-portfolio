# Public hosted-form URLs. Do not place private payment, scheduling, Slack, Drive, or Zoom links here.
VITE_RSA_APPLICATION_URL=
VITE_RSA_INTEREST_URL=

# Full production URL for the landing page, without a trailing slash.
VITE_RSA_CANONICAL_URL=

# Sites runtime equivalents. Configure these in Sites for production so a form
# or canonical domain can be updated without rebuilding the client bundle.
RSA_APPLICATION_URL=
RSA_INTEREST_URL=
RSA_CANONICAL_URL=

# Optional Plausible site domain. When set in Sites, page views and the existing
# accelerator CTA events can be recorded by Plausible.
RSA_PLAUSIBLE_DOMAIN=
